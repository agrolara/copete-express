# URL pública de tu instancia de Supabase (ej: https://supabase.tudominio.com o local)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Clave pública de Supabase (Anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_key

# Clave de servicio de Supabase (Service Role key - solo backend/admin)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# Bucket de Storage para imágenes de productos y promociones
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=copete-express-media

# Número de WhatsApp para recibir pedidos (con código de país sin signo +)
NEXT_PUBLIC_WHATSAPP_NUMBER=56912345678
